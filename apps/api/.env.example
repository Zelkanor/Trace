# Runtime environment: development | production | test
APP_ENV=development
LOG_LEVEL=INFO

# Backend listening address
API_HOST=127.0.0.1
API_PORT=3001

# Browser origin allowed by CORS (scheme://host[:port], no path)
WEB_ORIGIN=http://localhost:3000

# Comma-separated Host headers accepted by the API
ALLOWED_HOSTS=localhost,127.0.0.1

# TRACE data-source mode: REPLAY | HYBRID | LIVE (independent of APP_ENV;
# production + REPLAY is valid). REPLAY forbids enabling any live connector.
TRACE_MODE=REPLAY
# Inference device: cpu | cuda (validated only; no Torch import)
TRACE_DEVICE=cpu
# Relative paths resolve against the workspace root, not the current directory
TRACE_DB_PATH=data/trace.sqlite3

# Live connectors (must stay false in REPLAY)
GDELT_ENABLED=false
SEC_ENABLED=false
# Required when SEC_ENABLED=true; blank means unset
SEC_USER_AGENT=
