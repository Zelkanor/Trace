# Runtime environment: development | production | test
APP_ENV=development
LOG_LEVEL=INFO

# Backend listening address
API_HOST=127.0.0.1
API_PORT=3001

# Browser origin allowed by CORS (scheme://host[:port], no path)
WEB_ORIGIN=http://localhost:3000

# Comma-separated Host headers accepted by the API
ALLOWED_HOSTS=localhost,127.0.0.1
