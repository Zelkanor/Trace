{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "bun --env-file=.env run dev:next",
    "dev:next": "next dev --port $WEB_PORT",
    "lint": "eslint . --max-warnings 0",
    "start": "bun --env-file=.env run start:next",
    "start:next": "next start --port $WEB_PORT"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "typescript": "7.0.2"
  }
}
